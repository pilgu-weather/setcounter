DATABASE_URL=postgresql://user:password@localhost:5432/setcounter
SECRET_KEY=change-this-to-a-long-random-secret
APP_ENV=development
SETCOUNTER_SESSION_COOKIE_SECURE=0
SETCOUNTER_TRUST_PROXY=0
REMINDER_CRON_TOKEN=change-this-to-a-long-random-cron-token
DISCORD_COMPLAINT_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-your-webhook
ANDROID_SHA256_CERT_FINGERPRINT=AA:BB:CC:replace-with-play-app-signing-fingerprint
PUBLIC_SUPPORT_EMAIL=support@example.com
